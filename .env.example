# ==============================================================================
# SÓ DE OLHO - Variáveis de Ambiente (.env.example)
# "Acompanhando lançamentos... estritamente para fins informativos"
# ==============================================================================
# Dica: Você também pode configurar todas essas chaves diretamente pela interface
# do aplicativo clicando no ícone de Engrenagem (Configurações / Chaves) no topo!

# 1. The Movie Database (TMDB API v3 Key ou Read Access Token) - Idioma: pt-BR
VITE_TMDB_API_KEY="sua_chave_tmdb_aqui"

# 2. RAWG Video Games Database API Key
VITE_RAWG_API_KEY="sua_chave_rawg_aqui"

# 3. Supabase (Auth, Database & Edge Functions)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anon_publica_supabase"

# 4. OneSignal Web Push Notifications
ONESIGNAL_APP_ID="seu_onesignal_app_id"
VITE_ONESIGNAL_APP_ID="seu_onesignal_app_id"

# 5. Variáveis exclusivas para as Supabase Edge Functions (Secrets do Backend)
# Configure via: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=... ONESIGNAL_REST_API_KEY=...
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_para_cron_job"
ONESIGNAL_REST_API_KEY="sua_onesignal_rest_api_key"
DEFAULT_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
DEFAULT_TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
DEFAULT_TELEGRAM_CHAT_ID="seu_chat_id"
DIGITAL_RELEASES_RSS_URL="https://exemplo-feed-releases-digitais.com/rss.xml"
